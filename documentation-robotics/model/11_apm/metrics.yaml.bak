# APM Metrics for Codetoreum Platform
# Tracks performance, reliability, and operational metrics

Execution Duration:
  id: apm.metric.execution-duration
  name: Execution Duration
  type: metric
  metricType: histogram
  unit: seconds
  documentation: Time taken for agent execution from start to completion
  measures:
    - application.service.execution-service
  tracksGoal: motivation.goal.automation
  properties:
    prometheus.metric.name: codetoreum_execution_duration_seconds
    aggregation: p50, p95, p99

Execution Success Rate:
  id: apm.metric.execution-success-rate
  name: Execution Success Rate
  type: metric
  metricType: gauge
  unit: percentage
  documentation: Percentage of successful agent executions
  measures:
    - application.service.execution-service
  tracksGoal: motivation.goal.reliability
  properties:
    prometheus.metric.name: codetoreum_execution_success_rate
    sla.target: 95%

API Response Time:
  id: apm.metric.api-response-time
  name: API Response Time
  type: metric
  metricType: histogram
  unit: milliseconds
  documentation: HTTP API endpoint response times
  measures:
    - application.component.rest-api-adapter
  tracksGoal: motivation.goal.scalability
  properties:
    prometheus.metric.name: codetoreum_api_response_time_ms
    aggregation: p50, p95, p99
    sla.target.p95: 500ms

API Error Rate:
  id: apm.metric.api-error-rate
  name: API Error Rate
  type: metric
  metricType: counter
  unit: count
  documentation: Number of API errors (4xx, 5xx responses)
  measures:
    - application.component.rest-api-adapter
  tracksGoal: motivation.goal.reliability
  properties:
    prometheus.metric.name: codetoreum_api_errors_total
    labels: status_code, endpoint

Circuit Breaker State:
  id: apm.metric.circuit-breaker-state
  name: Circuit Breaker State
  type: metric
  metricType: gauge
  unit: enum
  documentation: Current state of circuit breakers (open/half-open/closed)
  measures:
    - application.component.circuit-breaker
  tracksGoal: motivation.goal.resilience
  properties:
    prometheus.metric.name: codetoreum_circuit_breaker_state
    values: open=0, half-open=1, closed=2
    labels: service

Rate Limit Hits:
  id: apm.metric.rate-limit-hits
  name: Rate Limit Hits
  type: metric
  metricType: counter
  unit: count
  documentation: Number of rate limit threshold hits
  measures:
    - application.component.token-bucket-rate-limiter
  tracksGoal: motivation.goal.security
  properties:
    prometheus.metric.name: codetoreum_rate_limit_hits_total
    labels: limiter_name

Queue Depth:
  id: apm.metric.queue-depth
  name: Queue Depth
  type: metric
  metricType: gauge
  unit: count
  documentation: Number of pending tasks in execution queue
  measures:
    - application.component.task-queue
  tracksGoal: motivation.goal.scalability
  properties:
    prometheus.metric.name: codetoreum_queue_depth
    alert.threshold: 1000

Container Resource Usage:
  id: apm.metric.container-resource-usage
  name: Container Resource Usage
  type: metric
  metricType: gauge
  unit: percentage
  documentation: CPU and memory usage of agent containers
  measures:
    - application.component.docker-container-adapter
  tracksGoal: motivation.goal.scalability
  properties:
    prometheus.metric.name: codetoreum_container_resource_usage
    labels: resource_type, container_id

Event Bus Lag:
  id: apm.metric.event-bus-lag
  name: Event Bus Lag
  type: metric
  metricType: gauge
  unit: milliseconds
  documentation: Time lag between event publication and consumption
  measures:
    - application.component.event-bus-impl
  tracksGoal: motivation.goal.observability
  properties:
    prometheus.metric.name: codetoreum_event_bus_lag_ms
    alert.threshold: 5000

Cache Hit Rate:
  id: apm.metric.cache-hit-rate
  name: Cache Hit Rate
  type: metric
  metricType: gauge
  unit: percentage
  documentation: Configuration cache hit rate
  measures:
    - application.component.redis-config-cache
  tracksGoal: motivation.goal.scalability
  properties:
    prometheus.metric.name: codetoreum_cache_hit_rate
    target: 90%

Workflow Completion Time:
  id: apm.metric.workflow-completion-time
  name: Workflow Completion Time
  type: metric
  metricType: histogram
  unit: seconds
  documentation: Time from workflow start to completion
  measures:
    - application.service.workflow-orchestrator
  tracksGoal: motivation.goal.developer-productivity
  properties:
    prometheus.metric.name: codetoreum_workflow_completion_time_seconds
    aggregation: p50, p95, p99

Review Cycle Duration:
  id: apm.metric.review-cycle-duration
  name: Review Cycle Duration
  type: metric
  metricType: histogram
  unit: seconds
  documentation: Time taken for review cycle completion
  measures:
    - application.service.review-service
  tracksGoal: motivation.goal.quality-assurance
  properties:
    prometheus.metric.name: codetoreum_review_cycle_duration_seconds
    aggregation: p50, p95, p99

Agent Matching Accuracy:
  id: apm.metric.agent-matching-accuracy
  name: Agent Matching Accuracy
  type: metric
  metricType: gauge
  unit: percentage
  documentation: Accuracy of agent-to-work-item matching
  measures:
    - application.service.agent-matching
  tracksGoal: motivation.goal.quality-assurance
  properties:
    prometheus.metric.name: codetoreum_agent_matching_accuracy
    target: 85%

Event Store Write Latency:
  id: apm.metric.event-store-write-latency
  name: Event Store Write Latency
  type: metric
  metricType: histogram
  unit: milliseconds
  documentation: Latency for writing events to Elasticsearch event store
  measures:
    - application.component.elasticsearch-event-store-adapter
  tracksGoal: motivation.goal.observability
  properties:
    prometheus.metric.name: codetoreum_event_store_write_latency_ms
    aggregation: p50, p95, p99

Dead Letter Queue Size:
  id: apm.metric.dead-letter-queue-size
  name: Dead Letter Queue Size
  type: metric
  metricType: gauge
  unit: count
  documentation: Number of failed events in dead letter queue
  measures:
    - application.component.dead-letter-queue
  tracksGoal: motivation.goal.reliability
  properties:
    prometheus.metric.name: codetoreum_dlq_size
    alert.threshold: 100

LLM Token Usage:
  id: apm.metric.llm-token-usage
  name: LLM Token Usage
  type: metric
  metricType: counter
  unit: tokens
  documentation: Total tokens consumed by LLM provider
  measures:
    - application.component.claude-code-adapter
  tracksGoal: motivation.goal.cost-efficiency
  properties:
    prometheus.metric.name: codetoreum_llm_tokens_total
    labels: model, operation_type

GitHub API Rate Limit Remaining:
  id: apm.metric.github-api-rate-limit
  name: GitHub API Rate Limit Remaining
  type: metric
  metricType: gauge
  unit: count
  documentation: Remaining GitHub API rate limit quota
  measures:
    - application.component.github-ticket-adapter
  tracksGoal: motivation.goal.extensibility
  properties:
    prometheus.metric.name: codetoreum_github_rate_limit_remaining
    alert.threshold: 100

System Health Score:
  id: apm.metric.system-health-score
  name: System Health Score
  type: metric
  metricType: gauge
  unit: score
  documentation: Composite health score (0-100) based on multiple metrics
  measures:
    - application.component.health-checker
  tracksGoal: motivation.goal.reliability
  properties:
    prometheus.metric.name: codetoreum_system_health_score
    alert.threshold: 70
    weights: availability=0.4, latency=0.3, error_rate=0.3
