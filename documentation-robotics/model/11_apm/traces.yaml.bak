# APM Distributed Traces for Codetoreum Platform
# End-to-end tracing across service boundaries

Work Item Lifecycle Trace:
  id: apm.trace.work-item-lifecycle
  name: Work Item Lifecycle Trace
  type: trace
  documentation: End-to-end trace from work item creation to completion
  tracingFramework: OpenTelemetry
  spans:
    - work-item-created
    - workflow-started
    - agent-matched
    - agent-executed
    - review-completed
    - work-item-completed
  trackedProcesses:
    - business.process.issue-to-pr-automation
  properties:
    trace.sample.rate: 1.0
    retention.days: 30

Agent Execution Trace:
  id: apm.trace.agent-execution
  name: Agent Execution Trace
  type: trace
  documentation: Detailed trace of single agent execution lifecycle
  tracingFramework: OpenTelemetry
  spans:
    - execution-queued
    - container-created
    - context-mounted
    - llm-invoked
    - code-generated
    - container-destroyed
    - execution-completed
  trackedProcesses:
    - business.process.agent-execution-cycle
  properties:
    trace.sample.rate: 0.1
    retention.days: 14
    includes.logs: true

API Request Trace:
  id: apm.trace.api-request
  name: API Request Trace
  type: trace
  documentation: Trace of HTTP API request through all layers
  tracingFramework: OpenTelemetry
  spans:
    - api-request-received
    - authentication-checked
    - rate-limit-checked
    - service-invoked
    - database-query
    - response-serialized
    - api-response-sent
  trackedServices:
    - application.service.configuration-service
    - application.service.work-item-service
    - application.service.execution-service
  properties:
    trace.sample.rate: 0.05
    retention.days: 7

Event Flow Trace:
  id: apm.trace.event-flow
  name: Event Flow Trace
  type: trace
  documentation: Trace of domain event from publication to all consumers
  tracingFramework: OpenTelemetry
  spans:
    - event-published
    - event-serialized
    - event-buffered
    - event-consumed
    - handler-invoked
    - event-persisted
  trackedComponents:
    - application.component.event-bus-impl
    - application.component.event-persistence-worker
  properties:
    trace.sample.rate: 0.01
    retention.days: 7

Workflow Orchestration Trace:
  id: apm.trace.workflow-orchestration
  name: Workflow Orchestration Trace
  type: trace
  documentation: Trace of workflow execution across multiple stages
  tracingFramework: OpenTelemetry
  spans:
    - workflow-initialized
    - stage-1-started
    - stage-1-completed
    - stage-2-started
    - stage-2-completed
    - workflow-completed
  trackedProcesses:
    - business.process.automated-development-workflow
  properties:
    trace.sample.rate: 1.0
    retention.days: 30
    includes.span.attributes: workflow_id, stage_names, agent_ids

Review Cycle Trace:
  id: apm.trace.review-cycle
  name: Review Cycle Trace
  type: trace
  documentation: Trace of maker-checker review cycle with feedback loops
  tracingFramework: OpenTelemetry
  spans:
    - review-initiated
    - reviewer-assigned
    - feedback-submitted
    - changes-requested
    - re-execution-triggered
    - review-approved
  trackedProcesses:
    - business.process.maker-checker-review
  properties:
    trace.sample.rate: 1.0
    retention.days: 30
