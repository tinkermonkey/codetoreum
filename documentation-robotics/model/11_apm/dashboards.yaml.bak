# APM Dashboards for Codetoreum Platform
# Visualization and monitoring dashboards

System Health Dashboard:
  id: apm.dashboard.system-health
  name: System Health Dashboard
  type: dashboard
  documentation: Overall system health and performance overview
  platform: Grafana
  displays:
    - apm.metric.system-health-score
    - apm.metric.execution-success-rate
    - apm.metric.api-response-time
    - apm.metric.api-error-rate
    - apm.metric.circuit-breaker-state
    - apm.metric.queue-depth
    - apm.metric.dead-letter-queue-size
  refreshInterval: 30s
  properties:
    dashboard.category: operations
    alert.integration: pagerduty
    audience: platform-operators

Execution Monitoring Dashboard:
  id: apm.dashboard.execution-monitoring
  name: Execution Monitoring Dashboard
  type: dashboard
  documentation: Agent execution metrics and performance tracking
  platform: Grafana
  displays:
    - apm.metric.execution-duration
    - apm.metric.execution-success-rate
    - apm.metric.container-resource-usage
    - apm.metric.agent-matching-accuracy
    - apm.metric.llm-token-usage
  refreshInterval: 10s
  properties:
    dashboard.category: execution
    audience: developers, platform-operators
    includes.traces: true
    trace.filter: apm.trace.agent-execution

API Performance Dashboard:
  id: apm.dashboard.api-performance
  name: API Performance Dashboard
  type: dashboard
  documentation: REST API performance and usage metrics
  platform: Grafana
  displays:
    - apm.metric.api-response-time
    - apm.metric.api-error-rate
    - apm.metric.rate-limit-hits
    - apm.metric.github-api-rate-limit
  refreshInterval: 5s
  properties:
    dashboard.category: api
    audience: developers, api-consumers
    includes.logs: true
    log.filter: severity=ERROR

Workflow Analytics Dashboard:
  id: apm.dashboard.workflow-analytics
  name: Workflow Analytics Dashboard
  type: dashboard
  documentation: Workflow execution analytics and trends
  platform: Grafana
  displays:
    - apm.metric.workflow-completion-time
    - apm.metric.review-cycle-duration
    - apm.metric.execution-success-rate
  refreshInterval: 60s
  properties:
    dashboard.category: analytics
    audience: project-managers, developers
    time.range: 7d
    includes.trends: true

Infrastructure Resilience Dashboard:
  id: apm.dashboard.infrastructure-resilience
  name: Infrastructure Resilience Dashboard
  type: dashboard
  documentation: Resilience patterns and infrastructure health
  platform: Grafana
  displays:
    - apm.metric.circuit-breaker-state
    - apm.metric.rate-limit-hits
    - apm.metric.event-bus-lag
    - apm.metric.cache-hit-rate
    - apm.metric.event-store-write-latency
  refreshInterval: 30s
  properties:
    dashboard.category: infrastructure
    audience: platform-operators, sre-team
    alert.integration: slack

Cost Tracking Dashboard:
  id: apm.dashboard.cost-tracking
  name: Cost Tracking Dashboard
  type: dashboard
  documentation: Resource consumption and cost tracking
  platform: Grafana
  displays:
    - apm.metric.llm-token-usage
    - apm.metric.container-resource-usage
    - apm.metric.github-api-rate-limit
  refreshInterval: 300s
  properties:
    dashboard.category: cost
    audience: platform-operators, finance-team
    time.range: 30d
    includes.trends: true
    cost.aggregation: daily
