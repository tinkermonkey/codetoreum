# ============================================================================
# Codetoreum Production Environment Configuration
# ============================================================================
# Copy this file to .env and configure with your production credentials.
# This file documents all required variables for production deployment.
# Credentials marked as REQUIRED must be configured before deployment.

# ============================================================================
# CRITICAL: Credentials Required for Production MVP
# ============================================================================

# GitHub Authentication
# ===================================
# One of the following authentication methods is required:
#   1. GITHUB_TOKEN: Personal Access Token (recommended for simple setup)
#   2. GitHub App (GITHUB_APP_ID, GITHUB_PRIVATE_KEY_PATH, GITHUB_INSTALLATION_ID)
#
# Required Scopes for GITHUB_TOKEN:
#   - repo (full control of private repositories)
#   - read:project (read GitHub Projects)
#   - read:org (read organization data)
#
# How to obtain:
#   - Personal Token: https://github.com/settings/tokens
#   - GitHub App: https://github.com/settings/apps (for organization-wide auth)
#
# Personal Access Token (Classic or Fine-grained) — uncomment if using PAT
# Prefix: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (classic) or github_pat_xxxx... (fine-grained)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App Authentication (Organization-wide) — uncomment if using GitHub App
# Recommended for organizations: better scoping and audit trail
#GITHUB_APP_ID=123456
#GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem
#GITHUB_INSTALLATION_ID=12345678
#
# How to set up GitHub App:
#   1. Go to https://github.com/settings/apps and create a new app
#   2. Set up required permissions (Contents, Issues, Pull Requests, Projects)
#   3. Install the app on your organization
#   4. Download the private key and save to a secure location
#   5. Set GITHUB_APP_ID to the app ID
#   6. Set GITHUB_PRIVATE_KEY_PATH to the path of the private key file
#   7. Set GITHUB_INSTALLATION_ID to the installation ID (find in Settings → GitHub Apps)

# GitHub Organization
# The GitHub organization where Codetoreum will manage issues and projects
# Example: "codetoreum-org"
GITHUB_ORG=

# Claude Code OAuth Token
# REQUIRED: OAuth token for Claude Code agent authentication
# This token is held by the server process and is NOT passed to agent containers.
# The server uses this token to authenticate against Claude Code CLI.
#
# How to obtain:
#   1. Install Claude Code: https://claude.com/claude-code
#   2. Authenticate with `claude login`
#   3. The token is stored locally (typically in ~/.claude/auth.json)
#   4. Obtain the OAuth token for server use (contact Anthropic support or see docs)
#
# IMPORTANT: This is an OAuth token, NOT an Anthropic API key
# Do NOT use ANTHROPIC_API_KEY here — Claude Code authentication requires OAuth
#
CLAUDE_CODE_OAUTH_TOKEN=

# Docker Runtime Configuration
# ===================================
# REQUIRED: Docker daemon connection
# Examples:
#   - unix:///var/run/docker.sock (local Unix socket, most common)
#   - unix:///run/podman/podman.sock (Podman alternative)
#   - tcp://docker-host:2375 (remote Docker daemon, requires TLS)
#
DOCKER_HOST=unix:///var/run/docker.sock

# Agent Workspace Base Directory
# ===================================
# REQUIRED: Base directory for container workspaces
# Codetoreum mounts project files into containers under this directory.
# Must have read/write permissions for the Codetoreum process.
# Examples:
#   - /tmp/codetoreum/workspaces
#   - /var/codetoreum/workspaces
#   - /data/agent-workspaces
#
AGENT_WORKSPACE_BASE=/tmp/codetoreum/workspaces

# JWT Authentication Secret
# ===================================
# REQUIRED (Production): Persistent secret for JWT token signing
# IMPORTANT: In production, this must be persistent across restarts.
#            If the secret changes, all issued tokens become invalid.
#
# Generate a secure secret with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
#
# In production, consider storing this in a secrets manager (e.g., Vault, AWS Secrets Manager)
#
CODETOREUM_SECRET_KEY=

# Application Environment
# ===================================
# Set to "production" for production deployments
# This enables additional security checks and performance optimizations
#
CODETOREUM_ENV=production

# ============================================================================
# OPTIONAL: Infrastructure and Observability
# ============================================================================

# Redis Configuration (Optional)
# Used for caching, distributed locks, and event persistence.
# If not configured, falls back to in-memory implementations.
# Examples:
#   - redis://localhost:6379/0 (local)
#   - redis://:password@redis-host:6379/0 (with authentication)
#   - rediss://redis-host:6379/0 (TLS)
#
REDIS_URL=

# Elasticsearch Configuration (Optional)
# Used for advanced event store features and full-text search.
# If not configured, falls back to file-based or in-memory storage.
# Examples:
#   - http://elasticsearch:9200
#   - https://user:password@es-cluster.example.com:9200
#
ELASTICSEARCH_URL=

# Observability: Signoz Configuration (Optional)
# For distributed tracing and metrics collection.
# Signoz is a DataDog/NewRelic alternative for observability.
#
SIGNOZ_ENABLED=false
SIGNOZ_API_KEY=
SIGNOZ_HOST=http://localhost:8900
SIGNOZ_GRPC_PORT=4317

# ============================================================================
# Development / Non-Critical Settings
# ============================================================================

# Database Configuration (if using PostgreSQL config store)
DATABASE_URL=

# Application Settings
APP_NAME=codetoreum
DEBUG=false
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Git Configuration
# Used by the repository adapter for git operations
GIT_USER=codetoreum-agent
GIT_EMAIL=codetoreum@example.com

# ============================================================================
# Pre-Flight Checklist for Deployment
# ============================================================================
# Before deploying Codetoreum to production:
#
# [ ] GITHUB_TOKEN is set and has required scopes (repo, read:project, read:org)
# [ ] CLAUDE_CODE_OAUTH_TOKEN is obtained and set (NOT an API key)
# [ ] DOCKER_HOST is set and accessible (e.g., unix:///var/run/docker.sock)
# [ ] AGENT_WORKSPACE_BASE directory exists and is writable
# [ ] CODETOREUM_SECRET_KEY is set to a secure random value
# [ ] CODETOREUM_ENV is set to "production"
# [ ] Run: python -m codetoreum.cli.validate_credentials
#        All critical adapters should show PASS status
# [ ] Test a simple workflow to ensure end-to-end integration works
#
# ============================================================================
