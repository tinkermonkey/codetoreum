# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=codetoreum
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/codetoreum
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Container Runtime
DOCKER_HOST=unix:///var/run/docker.sock
AGENT_WORKSPACE_BASE=/tmp/codetoreum/workspaces

# GitHub Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Claude API (for LLM provider)
ANTHROPIC_API_KEY=

# Security
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Token Authentication
# IMPORTANT: In production (CODETOREUM_ENV=production), CODETOREUM_SECRET_KEY is REQUIRED
# Without a persistent secret key, all JWT tokens will be invalidated on server restart
# Generate a secure secret key with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
CODETOREUM_SECRET_KEY=
CODETOREUM_ENV=development
CODETOREUM_TOKEN_EXPIRATION_DAYS=365

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Event Store
EVENT_STORE_BACKEND=redis
EVENT_STORE_RETENTION_DAYS=90

# Simulation Mode (for testing)
SIMULATION_MODE=false
SIMULATION_TIME_SCALE=10
