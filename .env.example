# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=codetoreum
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/codetoreum
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Container Runtime
DOCKER_HOST=unix:///var/run/docker.sock
AGENT_WORKSPACE_BASE=/tmp/codetoreum/workspaces

# GitHub Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Claude API (for LLM provider)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# JWT Token Authentication
# IMPORTANT: In production (CODETOREUM_ENV=production), CODETOREUM_SECRET_KEY is REQUIRED
# Without a persistent secret key, all JWT tokens will be invalidated on server restart
# Generate a secure secret key with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
CODETOREUM_SECRET_KEY=
CODETOREUM_ENV=development
CODETOREUM_TOKEN_EXPIRATION_DAYS=365

# ============================================================================
# OpenTelemetry / Observability Configuration
# ============================================================================

# Master Switches
OTEL_ENABLED=true                      # Master switch for all observability
OTEL_TRACES_ENABLED=true               # Enable/disable tracing
OTEL_METRICS_ENABLED=false             # Enable/disable metrics (future)
OTEL_LOGS_ENABLED=false                # Enable/disable log export to Signoz

# Signoz Configuration
SIGNOZ_ENABLED=true
SIGNOZ_HOST=http://192.168.0.245
SIGNOZ_UI_PORT=8900
SIGNOZ_GRPC_PORT=4317
SIGNOZ_HTTP_PORT=4318
SIGNOZ_API_KEY=9TEDZjVxdq+BCQV6DyTFsPMzau8SofdqiH4CwOz+Y+U=
SIGNOZ_SERVICE_NAME=codetoreum
SIGNOZ_INSECURE=true

# Tracing Sampling Configuration
# Sampler types: always_on, always_off, traceidratio, parentbased_always_on
OTEL_TRACES_SAMPLER=always_on          # Use 'traceidratio' for production
OTEL_TRACES_SAMPLER_ARG=1.0            # For traceidratio: 0.0-1.0 (e.g., 0.1 = 10%)

# Auto-Instrumentation Control
OTEL_AUTO_INSTRUMENT_LIBRARIES=true    # SQLAlchemy, Redis, HTTP clients
OTEL_INSTRUMENT_DOMAIN=true            # Domain layer operations
OTEL_INSTRUMENT_APPLICATION=true       # Application services
OTEL_INSTRUMENT_ADAPTERS=true          # External adapters (GitHub, Claude, etc.)

# Performance Tuning
OTEL_BATCH_SPAN_PROCESSOR_MAX_QUEUE_SIZE=2048
OTEL_BATCH_SPAN_PROCESSOR_MAX_EXPORT_BATCH_SIZE=512
OTEL_BATCH_SPAN_PROCESSOR_SCHEDULE_DELAY_MILLIS=5000

# Debug
OTEL_LOG_LEVEL=info                    # debug, info, warning, error

# Legacy Settings (for backward compatibility)
ENABLE_METRICS=true
ENABLE_TRACING=true

# Event Store
EVENT_STORE_BACKEND=redis
EVENT_STORE_RETENTION_DAYS=90

# Simulation Mode (for testing)
SIMULATION_MODE=false
SIMULATION_TIME_SCALE=10
