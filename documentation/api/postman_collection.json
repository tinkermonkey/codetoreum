{
  "info": {
    "name": "Codetoreum API",
    "description": "AI Agent Orchestration Platform API\n\nAuthentication: Single-token JWT-based authentication. Get token from server startup logs.\n\nUsage:\n1. Set the `base_url` and `api_token` variables in your environment\n2. Token is automatically included in requests via Authorization header\n3. All endpoints require authentication except health checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "your_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Authentication",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "health"]
            },
            "description": "Simple health check endpoint (no authentication required)"
          }
        },
        {
          "name": "Health Ready",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/health/ready",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "health", "ready"]
            },
            "description": "Readiness check with dependency status (no authentication required)"
          }
        },
        {
          "name": "Get Token Info",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/auth/token-info?token={{api_token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "token-info"],
              "query": [
                {
                  "key": "token",
                  "value": "{{api_token}}"
                }
              ]
            },
            "description": "Get information about your authentication token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v2/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "logout"]
            },
            "description": "Logout and clear authentication cookie"
          }
        }
      ]
    },
