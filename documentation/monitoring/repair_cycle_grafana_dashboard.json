{
  "dashboard": {
    "title": "Repair Cycle Monitoring",
    "description": "Comprehensive monitoring for AI-powered repair cycle execution",
    "tags": ["repair-cycle", "testing", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 35,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Repair Cycles - Success Rate",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "round(codetoreum_repair_cycle_successful_total / (codetoreum_repair_cycle_completed_total) * 100, 1) or 0",
            "legendFormat": "Success Rate (%)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "orange", "value": 50},
                {"color": "green", "value": 80}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 2,
        "title": "Total Repair Cycles",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 3, "h": 4},
        "targets": [
          {
            "expr": "codetoreum_repair_cycle_completed_total",
            "legendFormat": "Completed",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Active Repair Cycles",
        "type": "stat",
        "gridPos": {"x": 7, "y": 0, "w": 3, "h": 4},
        "targets": [
          {
            "expr": "sum(codetoreum_repair_cycle_active_count)",
            "legendFormat": "Active",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Fast Failures",
        "type": "stat",
        "gridPos": {"x": 10, "y": 0, "w": 3, "h": 4},
        "targets": [
          {
            "expr": "codetoreum_repair_cycle_fast_failed_total",
            "legendFormat": "Fast Failed",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "red", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Cycle Duration (seconds)",
        "type": "graph",
        "gridPos": {"x": 13, "y": 0, "w": 11, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(codetoreum_repair_cycle_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{agent_name}} {{status}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(codetoreum_repair_cycle_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 {{agent_name}} {{status}}",
            "refId": "B"
          }
        ]
      },
      {
        "id": 6,
        "title": "Repair Cycles by Status (24h)",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 4, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_completed_total{status=~\"success|failed\"}[24h])",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Test Execution Count by Type",
        "type": "bargauge",
        "gridPos": {"x": 6, "y": 4, "w": 7, "h": 8},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_test_executions_total[1h])",
            "legendFormat": "{{test_type}} ({{status}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Agent Calls per Cycle",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "codetoreum_repair_cycle_agent_calls_per_cycle",
            "legendFormat": "{{agent_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 1
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Files Fixed Statistics",
        "type": "stat",
        "gridPos": {"x": 12, "y": 12, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_files_fixed_total[24h])",
            "legendFormat": "Fixed: {{file_extension}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "Test Failures by Type (24h)",
        "type": "table",
        "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_test_failures_total[24h])",
            "legendFormat": "{{test_type}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 11,
        "title": "Fast-Fail Reasons",
        "type": "table",
        "gridPos": {"x": 12, "y": 18, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_fast_failed_total[24h])",
            "legendFormat": "{{reason}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 12,
        "title": "Test Execution Duration by Type",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(codetoreum_repair_cycle_test_execution_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{test_type}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(codetoreum_repair_cycle_test_execution_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 {{test_type}}",
            "refId": "B"
          }
        ]
      },
      {
        "id": 13,
        "title": "File Fix Duration by Type",
        "type": "graph",
        "gridPos": {"x": 12, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(codetoreum_repair_cycle_file_fix_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{file_extension}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 14,
        "title": "Warnings Reviewed",
        "type": "stat",
        "gridPos": {"x": 0, "y": 30, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "increase(codetoreum_repair_cycle_warnings_reviewed_total[24h])",
            "legendFormat": "{{severity}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 15,
        "title": "Per-Agent Success Rate",
        "type": "table",
        "gridPos": {"x": 6, "y": 30, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "label_join((increase(codetoreum_repair_cycle_successful_total[24h])) / (increase(codetoreum_repair_cycle_completed_total[24h])) * 100, \"agent_name\", \"\", \"agent_name\")",
            "legendFormat": "{{agent_name}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  }
}
