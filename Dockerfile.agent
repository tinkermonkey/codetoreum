# ============================================================================
# Stage 1: Base Environment Setup
# ============================================================================
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# ============================================================================
# Stage 2: Install Project-Specific Runtimes
# ============================================================================
# This is a Python-based project, so we don't need additional runtimes
# The base image already provides Python 3.11

# Install any additional system packages that may be needed for Python dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ============================================================================
# Stage 3: Pre-install Dependencies (OPTIONAL but RECOMMENDED)
# ============================================================================
# Pre-installing dependencies speeds up agent startup time because the agent
# doesn't have to install them every time it runs.

# WORKDIR should match where the orchestrator will mount the project
WORKDIR /workspace/codetoreum

# Copy ONLY the dependency manifests needed for installation
# DO NOT copy source code - it comes from the runtime mount
COPY requirements.txt* ./

# Pre-install Python dependencies if requirements.txt exists
# Use BuildKit cache mount for pip cache to speed up rebuilds
RUN if [ -f requirements.txt ]; then \
    pip install --no-cache-dir -r requirements.txt; \
    fi

# Install pre-commit so repair cycle agents can run `pre-commit run --all-files`.
# The local hooks in .pre-commit-config.yaml use `language: system`, meaning they
# rely on binaries already in PATH (ruff, black, mypy) — these come from the base image.
RUN pip install --no-cache-dir pre-commit

# ============================================================================
# Stage 4: Ownership and Permissions
# ============================================================================
# Change ownership ONLY of what was installed, NOT source code
# Source code ownership is handled by the mount

# Python packages are installed as root in /usr/local, no chown needed

# NOTE: Do NOT touch /home/orchestrator/.gitconfig here.
# It is a runtime bind mount injected by the orchestrator — never create,
# remove, or modify it during the image build.

# ============================================================================
# Stage 5: Configure Headless Environment
# ============================================================================
# Disable dbus-based secret storage for gh CLI. In a headless container there
# is no session bus, so gh would fail or hang trying to reach gnome-keyring.
# GH_NO_KEYRING tells gh to fall back to file-based token storage.
ENV GH_NO_KEYRING=1
# Prevent any tool from attempting a dbus session connection.
ENV DBUS_SESSION_BUS_ADDRESS=disabled:

# ============================================================================
# Stage 6: Install Entrypoint Script
# ============================================================================
# The entrypoint validates the git environment at startup and repairs common
# DinD mount corruption (e.g. .gitconfig appearing as a directory).
COPY scripts/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh

# ============================================================================
# Stage 7: Switch to Runtime User
# ============================================================================
USER orchestrator

# ============================================================================
# Stage 8: Verification (MANDATORY)
# ============================================================================
# Verify all critical CLIs are present (from base image)
RUN claude --version && \
    git --version && \
    gh --version && \
    python3 --version && \
    pip --version

# Verify ruff and pre-commit are installed and accessible (required by pre-commit
# hooks which use 'language: system' and expect these binaries in PATH)
RUN ruff --version && \
    pre-commit --version

# ============================================================================
# Default command
# ============================================================================
ENTRYPOINT ["agent-entrypoint.sh"]
CMD ["/bin/bash"]
